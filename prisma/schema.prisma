generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Position {
  QB
  TQB
  RB
  WR
  TE
  DT
  DE
  LB
  CB
  S
  K
  P
  HC
  DST
}

enum LineupSlot {
  QB
  TQB
  RB
  RB_WR
  WR
  TE
  FLEX
  WR_TE
  OP
  SUPERFLEX
  DT
  DE
  LB
  DL
  CB
  S
  DB
  DP
  K
  P
  HC
  DST
  BENCH
  IR
}

enum ScoringFormat {
  STANDARD
  HALF_PPR
  FULL_PPR
  CUSTOM
}

enum RosterFormat {
  STANDARD
  SUPERFLEX
  CUSTOM
}

enum UserRole {
  USER
  ADMIN
}

enum ProviderType {
  MANUAL
  CSV
  API
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         UserRole  @default(USER)
  teams        Team[]
  leagues      League[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model League {
  id          String             @id @default(cuid())
  name        String
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  settings    LeagueSettings?
  teams       Team[]
  matchups    LeagueMatchup[]
  projections PlayerProjection[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id                    String                 @id @default(cuid())
  name                  String
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueId              String
  league                League                 @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  rosterPlayers         RosterPlayer[]
  waiverRecommendations WaiverRecommendation[]
  lineupRecommendations LineupRecommendation[]
  waiverCandidates      WaiverCandidate[]
  weeklyReports         WeeklyTeamReport[]
  matchups              LeagueMatchup[]        @relation("MatchupTeam")
  opponentMatchups      LeagueMatchup[]        @relation("MatchupOpponent")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId])
  @@index([leagueId])
}

model LeagueSettings {
  id                     String        @id @default(cuid())
  leagueId               String        @unique
  league                 League        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  scoringFormat          ScoringFormat @default(HALF_PPR)
  rosterFormat           RosterFormat  @default(STANDARD)
  passingYardsPerPoint   Float         @default(25)
  pointsPerPassingTd     Float         @default(4)
  pointsPerInterception  Float         @default(-2)
  rushingYardsPerPoint   Float         @default(10)
  pointsPerRushingTd     Float         @default(6)
  pointsPerReception     Float         @default(0.5)
  receivingYardsPerPoint Float         @default(10)
  pointsPerReceivingTd   Float         @default(6)
  rosterSlots            Json
  rosterMaximums         Json          @default("{}")
  espnScoring            Json          @default("{}")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Player {
  id            String             @id @default(cuid())
  fullName      String
  firstName     String?
  lastName      String?
  nflTeam       String
  position      Position
  active        Boolean            @default(true)
  externalIds   PlayerExternalId[]
  rosterEntries RosterPlayer[]
  projections   PlayerProjection[]
  rankings      PlayerRanking[]
  injuries      PlayerInjury[]
  matchups      PlayerMatchup[]
  waiverEntries WaiverCandidate[]
  nflRosters    NflRosterStatus[]
  weeklyStats   PlayerWeeklyStat[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([fullName])
  @@index([nflTeam, position])
}

model DataProvider {
  id          String                    @id @default(cuid())
  key         String                    @unique
  name        String
  type        ProviderType
  active      Boolean                   @default(true)
  externalIds PlayerExternalId[]
  projections PlayerProjection[]
  rankings    PlayerRanking[]
  injuries    PlayerInjury[]
  matchups    PlayerMatchup[]
  rosterRows  NflRosterStatus[]
  weeklyStats PlayerWeeklyStat[]
  syncRuns    ProviderSyncRun[]
  unmatched   UnmatchedProviderRecord[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model PlayerExternalId {
  id          String       @id @default(cuid())
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId  String
  provider    DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalId  String
  matchMethod String       @default("STABLE_ID")
  confidence  Float        @default(1)
  verifiedAt  DateTime?

  @@unique([providerId, externalId])
  @@unique([playerId, providerId])
}

model RosterPlayer {
  id           String             @id @default(cuid())
  teamId       String
  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  currentSlot  LineupSlot         @default(BENCH)
  injuryStatus String             @default("HEALTHY")
  projections  WeeklyProjection[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([teamId, playerId])
  @@index([teamId, currentSlot])
  @@index([playerId])
}

model WaiverCandidate {
  id                 String   @id @default(cuid())
  teamId             String
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId           String?
  player             Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  name               String
  nflTeam            String
  position           Position
  projectedPoints    Float
  floorPoints        Float?
  ceilingPoints      Float?
  consistency        Float    @default(0.5)
  matchupRating      Float    @default(0)
  injuryMultiplier   Float    @default(1)
  restOfSeasonPoints Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([teamId, position])
  @@index([playerId])
}

model PlayerProjection {
  id              String       @id @default(cuid())
  playerId        String
  player          Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId      String
  provider        DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leagueId        String?
  league          League?      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season          Int
  week            Int
  projectedPoints Float
  floorPoints     Float?
  ceilingPoints   Float?
  restOfSeason    Float?
  consistency     Float        @default(0.5)
  matchupRating   Float        @default(0)
  sourcePayload   Json?
  projectedStats  Json?
  sourceUpdatedAt DateTime?
  fetchedAt       DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  importedAt      DateTime     @default(now())

  @@unique([playerId, providerId, leagueId, season, week])
  @@index([season, week, providerId])
}

model PlayerRanking {
  id         String       @id @default(cuid())
  playerId   String
  player     Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId String
  provider   DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season     Int
  week       Int?
  rank       Int
  tier       Int?
  value      Float?
  importedAt DateTime     @default(now())

  @@unique([playerId, providerId, season, week])
  @@index([season, week, rank])
}

model PlayerInjury {
  id              String       @id @default(cuid())
  playerId        String
  player          Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId      String
  provider        DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season          Int
  week            Int
  status          String
  details         String?
  team            String?
  bodyPart        String?
  practiceStatus  String?
  reportDate      DateTime?
  sourceUpdatedAt DateTime?
  fetchedAt       DateTime     @default(now())
  multiplier      Float        @default(1)
  importedAt      DateTime     @default(now())

  @@unique([playerId, providerId, season, week])
  @@index([season, week, status])
}

model NflRosterStatus {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId    String
  provider      DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season        Int
  week          Int
  nflTeam       String
  status        String
  depthPosition String?
  jerseyNumber  String?
  sourcePayload Json?
  fetchedAt     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([playerId, providerId, season, week])
  @@index([season, week, nflTeam])
}

model PlayerWeeklyStat {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId    String
  provider      DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season        Int
  week          Int
  nflTeam       String?
  opponent      String?
  stats         Json
  sourcePayload Json?
  fetchedAt     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([playerId, providerId, season, week])
  @@index([season, week])
}

model ProviderSyncRun {
  id               String       @id @default(cuid())
  providerId       String
  provider         DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dataset          String
  status           String
  season           Int?
  week             Int?
  received         Int          @default(0)
  imported         Int          @default(0)
  updated          Int          @default(0)
  skipped          Int          @default(0)
  unmatched        Int          @default(0)
  stableIdMatches  Int          @default(0)
  fallbackMatches  Int          @default(0)
  ambiguousMatches Int          @default(0)
  errors           Int          @default(0)
  errorMessage     String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?

  @@index([providerId, dataset, startedAt])
}

model UnmatchedProviderRecord {
  id          String       @id @default(cuid())
  providerId  String
  provider    DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dataset     String
  externalId  String?
  displayName String?
  nflTeam     String?
  position    String?
  reason      String
  payload     Json
  resolvedAt  DateTime?
  playerId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([providerId, dataset, resolvedAt])
  @@index([externalId])
}

model PlayerMatchup {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  providerId    String
  provider      DataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season        Int
  week          Int
  opponent      String
  home          Boolean
  matchupRating Float        @default(0)
  details       Json?
  importedAt    DateTime     @default(now())

  @@unique([playerId, providerId, season, week])
  @@index([season, week, opponent])
}

model LeagueMatchup {
  id                      String   @id @default(cuid())
  leagueId                String
  league                  League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId                  String
  team                    Team     @relation("MatchupTeam", fields: [teamId], references: [id], onDelete: Cascade)
  opponentTeamId          String?
  opponentTeam            Team?    @relation("MatchupOpponent", fields: [opponentTeamId], references: [id], onDelete: SetNull)
  opponentName            String?
  season                  Int
  week                    Int
  teamProjectedPoints     Float?
  opponentProjectedPoints Float?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([leagueId, teamId, season, week])
  @@index([season, week])
}

model WeeklyProjection {
  id               String       @id @default(cuid())
  rosterPlayerId   String
  rosterPlayer     RosterPlayer @relation(fields: [rosterPlayerId], references: [id], onDelete: Cascade)
  season           Int
  week             Int
  projectedPoints  Float
  floorPoints      Float?
  ceilingPoints    Float?
  consistency      Float        @default(0.5)
  matchupRating    Float        @default(0)
  injuryMultiplier Float        @default(1)
  source           String
  sourcePayload    Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([rosterPlayerId, season, week, source])
  @@index([season, week])
}

model LineupRecommendation {
  id               String   @id @default(cuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season           Int
  week             Int
  lineup           Json
  alternatives     Json
  projectedPoints  Float
  confidence       Float
  explanation      String?
  algorithmVersion String
  createdAt        DateTime @default(now())

  @@index([teamId, season, week])
}

model WaiverRecommendation {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season            Int
  week              Int
  addPlayer         Json
  dropPlayer        Json?
  priorityScore     Float
  shortTermValue    Float
  restOfSeasonValue Float
  projectedGain     Float
  explanation       String?
  algorithmVersion  String
  createdAt         DateTime @default(now())

  @@index([teamId, season, week, priorityScore])
}

model WeeklyTeamReport {
  id                String   @id @default(cuid())
  teamId            String
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season            Int
  week              Int
  grade             String
  strongestPosition Position
  weakestPosition   Position
  riskiestStarter   String?
  bestBenchOption   String?
  summary           String
  algorithmVersion  String
  createdAt         DateTime @default(now())

  @@unique([teamId, season, week])
  @@index([teamId, season, week])
}
